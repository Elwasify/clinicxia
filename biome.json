{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "files": {
    "includes": ["src/**/*.ts", "src/**/*.tsx"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedImports": "error",
        "noUndeclaredVariables": "error",
        "noUnreachable": "error",
        "noUnusedVariables": "error"
      }
    }
  }
}
